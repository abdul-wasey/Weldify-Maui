<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Weldify.Controls.FeetInchesEntry"
             x:Name="this">

    <VerticalStackLayout Spacing="4">

        <!-- Label -->
        <Label
            Text="{Binding Label, Source={x:Reference this}}"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />

        <!-- ft / in / suttar row -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Feet -->
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}">
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       Text="{Binding Feet, Source={x:Reference this}, Mode=TwoWay}" />
            </Border>

            <Label Grid.Column="1"
                   Text="ft"
                   VerticalOptions="Center"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />

            <!-- Inches -->
            <Border Grid.Column="2"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}">
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       Text="{Binding Inches, Source={x:Reference this}, Mode=TwoWay}" />
            </Border>

            <Label Grid.Column="3"
                   Text="in"
                   VerticalOptions="Center"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />

            <!-- Suttar (1 inch = 8 suttar in Pakistani trades) -->
            <Border Grid.Column="4"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}">
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       Text="{Binding Suttar, Source={x:Reference this}, Mode=TwoWay}" />
            </Border>

            <Label Grid.Column="5"
                   Text="su"
                   VerticalOptions="Center"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />

        </Grid>

        <!-- Inline validation -->
        <Label Text="{Binding ValidationMessage, Source={x:Reference this}}"
               FontSize="11"
               TextColor="#DC2626"
               IsVisible="{Binding HasValidationError, Source={x:Reference this}}" />

    </VerticalStackLayout>
</ContentView>
